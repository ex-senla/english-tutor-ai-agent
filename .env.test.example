# Тестовое окружение — шаблон .env для VPS.
# Скопируйте в /opt/eta-test/.env и заполните реальными значениями (права 600, вне git).
# Файл .env НЕ коммитится (см. .gitignore). Это только плейсхолдеры.

# --- PostgreSQL (отдельная тестовая БД) ---
POSTGRES_DB=eta
POSTGRES_USER=eta
POSTGRES_PASSWORD=change-me-test-db

# --- Тестовый Telegram-бот (отдельный бот через @BotFather) ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_test_token
TELEGRAM_BOT_USERNAME=eta_test_bot

# --- AI (тестовый ключ, тот же провайдер) ---
AI_API_KEY=sk-test-placeholder
AI_BASE_URL=https://example.com/v1
AI_CHAT_MODEL=gpt-4o-mini

# --- Grafana (мониторинг, loopback + SSH-туннель) ---
# Admin-пароль задаётся ТОЛЬКО здесь (в /opt/eta-test/.env, вне git, права 600).
# Реальное значение в репозиторий НЕ коммитить. Смена пароля действует только при
# первом старте с пустым volume Grafana (см. docs/release-policy.md).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME__grafana_admin_password
