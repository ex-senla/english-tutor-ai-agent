# PostgreSQL credentials for local development (docker-compose.yml).
# ВАЖНО: эти значения должны совпадать с local-дефолтами SPRING_DATASOURCE_*
# в src/main/resources/application.yaml. При смене credentials синхронно
# поправьте и .env, и дефолты application.yaml.
POSTGRES_DB=eta
POSTGRES_USER=eta
POSTGRES_PASSWORD=eta
